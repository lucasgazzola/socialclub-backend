# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como `.env` y completá los valores reales.
# NUNCA se commitea el archivo `.env` (ver "Acuerdos de código", Sprint 0).
#
# Los valores de abajo son de ejemplo para DESARROLLO local. En los entornos
# desplegados (test / main en Azure) estas variables se cargan como secrets del
# Container App y del GitHub Environment — NO desde un archivo .env.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
# En producción (production): activa cookie `Secure`, deshabilita Swagger (/api/docs)
# y oculta la contraseña del admin en los logs del seed.
NODE_ENV=development

# Puerto en el que escucha la API
PORT=3000

# ── Swagger ──────────────────────────────────────────────────────────────────
# Documentación interactiva en /api/docs. Visible en todos los entornos MENOS
# producción (main). Por defecto: on fuera de 'production'. Se puede forzar con
# esta variable: en el entorno test se setea `true` (aunque corra NODE_ENV=production).
# SWAGGER_ENABLED=true

# ── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL.
#  - Local (sin Docker):     host = localhost
#  - Con docker-compose:     host = db  (nombre del servicio en docker-compose.yml)
#  - Azure (prod/test):      requiere `?sslmode=require` al final de la URL.
DATABASE_URL=postgresql://socialclub:socialclub@localhost:5432/socialclub?schema=public

# ── Autenticación (JWT) ──────────────────────────────────────────────────────
# Secreto para firmar los JWT. Generá uno propio y DISTINTO por entorno, p. ej.:
#   openssl rand -hex 48
JWT_SECRET=cambiar-este-secreto-por-uno-generado-en-cada-entorno
# Duración del token de acceso (formato de la librería `ms`: 8h, 1d, 30m, etc.)
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma). Debe ser el origin EXACTO del frontend
# (con https://, sin barra final). En prod es la URL de Vercel del entorno, p. ej.:
#   https://socialclub-frontend-test.vercel.app
CORS_ORIGIN=http://localhost:5173

# ── Usuario administrador inicial (creado por `npm run prisma:seed`) ─────────
# En producción DEFINÍ una contraseña propia y fuerte (secret del entorno).
# Si no se setea, queda el default público de abajo.
SEED_ADMIN_EMAIL=admin@socialclub.local
SEED_ADMIN_PASSWORD=Admin123!
