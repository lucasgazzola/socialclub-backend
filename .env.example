# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo como `.env` y completá los valores reales.
# NUNCA se commitea el archivo `.env` (ver "Acuerdos de código", Sprint 0).
#
# Los valores de abajo son de ejemplo para DESARROLLO local. En los entornos
# desplegados (test / main en Azure) estas variables se cargan como secrets del
# Container App y del GitHub Environment — NO desde un archivo .env.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production | test
# En producción (production): activa cookie `Secure`, deshabilita Swagger (/api/docs)
# y oculta la contraseña del admin en los logs del seed.
NODE_ENV=development

# Puerto en el que escucha la API
PORT=3000

# ── Swagger ──────────────────────────────────────────────────────────────────
# Documentación interactiva en /api/docs. Visible en todos los entornos MENOS
# producción (main). Por defecto: on fuera de 'production'. Se puede forzar con
# esta variable: en el entorno test se setea `true` (aunque corra NODE_ENV=production).
# SWAGGER_ENABLED=true

# ── Base de datos ────────────────────────────────────────────────────────────
# Cadena de conexión a PostgreSQL.
#  - Local (sin Docker):     host = localhost
#  - Con docker-compose:     host = db  (nombre del servicio en docker-compose.yml)
#  - Azure (prod/test):      requiere `?sslmode=require` al final de la URL.
DATABASE_URL=postgresql://socialclub:socialclub@localhost:5432/socialclub?schema=public

# ── Autenticación (JWT) ──────────────────────────────────────────────────────
# Secreto para firmar los JWT. Generá uno propio y DISTINTO por entorno, p. ej.:
#   openssl rand -hex 48
JWT_SECRET=cambiar-este-secreto-por-uno-generado-en-cada-entorno
# Duración del token de acceso (formato de la librería `ms`: 8h, 1d, 30m, etc.)
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos (separados por coma). Debe ser el origin EXACTO del frontend
# (con https://, sin barra final). En prod es la URL de Vercel del entorno, p. ej.:
#   https://socialclub-frontend-test.vercel.app
CORS_ORIGIN=http://localhost:5173

# ── Usuario administrador inicial (creado por `npm run prisma:seed`) ─────────
# En producción DEFINÍ una contraseña propia y fuerte (secret del entorno).
# Si no se setea, queda el default público de abajo.
SEED_ADMIN_EMAIL=admin@socialclub.local
SEED_ADMIN_PASSWORD=Admin123!

# ── Documentación (US-24): almacenamiento de archivos en el filesystem ─────────
# Carpeta donde se guardan los archivos adjuntos (relativa al repo o absoluta).
DOCS_STORAGE_DIR=storage/documentacion
# Tamaño máximo por archivo (MB).
DOCS_MAX_MB=10

# ── Emails de alertas de documentación (US-26) ───────────────────────────────
# Cualquier SMTP sirve. Gratuitos: Brevo (smtp-relay.brevo.com:587, 300/día),
# Gmail con contraseña de aplicación (smtp.gmail.com:465) o Mailtrap para
# pruebas (no entrega de verdad). Sin SMTP_HOST no se envía nada: solo se loguea.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Remitente: un email verificado en el proveedor (sin espacios, lo usa el CD).
# MAIL_FROM=avisos@tu-dominio.com
# URL del frontend para el enlace del email.
# APP_URL=http://localhost:5173

# ── Tareas automáticas (DT-22) ───────────────────────────────────────────────
# Secreto (mín. 16 caracteres) con el que el workflow `tareas-automaticas.yml`
# llama a POST /api/v1/tareas/<tarea>/programada en la cabecera x-tareas-token.
# Generalo con: openssl rand -hex 24. (ALERTAS_CRON_TOKEN es su nombre anterior.)
# TAREAS_TOKEN=

# ── Pasarela de pagos (TASK-51, docs/decisiones/0003) ─────────────────────────
# Sin MP_ACCESS_TOKEN se usa la pasarela SIMULADA: el pago se aprueba o rechaza
# desde la pantalla «Simulador de pago» del front (desarrollo y E2E).
# Con un Access Token de PRUEBA de Mercado Pago (empieza con TEST-) se paga en
# el sandbox con tarjetas de prueba. Guía en docs/decisiones/0003.
# PASARELA_PAGOS=simulada        # fuerza una pasarela: mercadopago | simulada
# MP_ACCESS_TOKEN=TEST-...
# Clave secreta del webhook (Tus integraciones → Webhooks). Valida la firma.
# MP_WEBHOOK_SECRET=
# URL pública de esta API para recibir los webhooks (en local no hace falta:
# el pago se confirma cuando el usuario vuelve de Mercado Pago).
# API_PUBLIC_URL=https://ca-socialclub-api-test.<region>.azurecontainerapps.io
