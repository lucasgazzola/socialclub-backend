// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — SocialClub
//
// Scope of this base version:
//   - Authentication (login / logout)              → US-39, US-40
//   - Immutable operation audit log                → US-32
//   - Administrative users with roles              → US-01, US-02, US-03
//   - Members (Person + MemberCategory)            → US-12 to US-15
//   - Events and Tickets with QR code              → US-30 (unique tickets)
//   - Sports fee configuration                     → US-20
//
// The model is designed to grow towards the full domain (Discipline,
// Enrollment, MemberFee, Payment, Event, Ticket, ...). New entities are added
// on top of this same base without major redesigns (modular scalability).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Actions recorded in the audit log. Typing them avoids inconsistent loose
/// strings and makes filtering/reporting easier.
enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
  LOGIN
  LOGOUT
  LOGIN_FAILED
}

/// Possible states of a sold ticket. A ticket is born VALID and changes state
/// when it is used (event access) or when it expires.
enum TicketStatus {
  VALID
  USED
  EXPIRED
}

/// System role catalog. A User can hold one or more roles at the same time,
/// hence the UserRole join table.
model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique // e.g. ADMIN, COLLABORATOR
  description String?
  createdAt   DateTime   @default(now())
  users       UserRole[]

  @@map("roles")
}

/// System user (whoever logs in). Different from "Person", which represents
/// someone managed by the club (member, student, participant).
model User {
  id            Int         @id @default(autoincrement())
  dni           String?     @unique
  email         String      @unique
  passwordHash  String
  name          String
  lastName      String
  active        Boolean     @default(true)
  lastLogin     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  roles         UserRole[]
  auditLogs     AuditLog[]  @relation("auditResponsible")

  @@map("users")
}

/// N-to-N relation between User and Role (multiple simultaneous roles).
model UserRole {
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Member category (e.g. Active, Life, Cadet). In later sprints it conditions
/// the fee calculation.
model MemberCategory {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  description  String?
  people       Person[]
  feeConfigs   SportsFeeConfig[]

  @@map("member_categories")
}

/// Club sports discipline (e.g. Football, Volleyball, Basketball). Each one may
/// have a different monthly fee amount per member category.
model Discipline {
  id           Int                  @id @default(autoincrement())
  name         String               @unique
  description  String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  feeConfigs   SportsFeeConfig[]

  @@map("disciplines")
}

/// Monthly sports fee amount configuration per discipline-category-period.
/// Amount changes apply from the period following the configured one, keeping
/// the history of previous periods.
model SportsFeeConfig {
  id            Int             @id @default(autoincrement())
  disciplineId  Int
  categoryId    Int
  appliedPeriod String          // "YYYY-MM" — period the amount applies to
  amount        Decimal         @db.Decimal(12, 2)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  discipline    Discipline      @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  category      MemberCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([disciplineId, categoryId, appliedPeriod])
  @@index([appliedPeriod])
  @@map("sports_fee_configs")
}

/// Person managed by the organization. It is the base entity; in this version
/// it represents members (US-12 to US-15).
model Person {
  id          Int             @id @default(autoincrement())
  name        String
  lastName    String
  dni         String          @unique
  birthDate   DateTime?
  email       String?
  phone       String?
  active      Boolean         @default(true)
  categoryId  Int?
  category    MemberCategory? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([lastName, name])
  @@map("people")
}

/// Club event. Each Event has a number of available tickets; selling tickets
/// atomically decrements that quota.
model Event {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  availableTickets Int      @default(0)
  tickets          Ticket[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("events")
}

/// Unique Event ticket. The `token` is a system-generated UUID v4 (unique and
/// non-repeatable) encoded in the ticket QR code. The `@unique` constraint on
/// `token` guarantees no two tickets share the same identifier.
model Ticket {
  id        Int          @id @default(autoincrement())
  token     String       @unique // secure UUID v4, unique per ticket
  eventId   Int
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    TicketStatus @default(VALID)
  createdAt DateTime     @default(now())

  @@index([eventId])
  @@map("tickets")
}

/// Immutable audit log.
/// IMPORTANT: this table only accepts INSERT from the application.
/// No UPDATE or DELETE must be run on it (see AuditService).
model AuditLog {
  id            Int         @id @default(autoincrement())
  timestamp     DateTime    @default(now())
  action        AuditAction
  entity        String // "User" | "Person" | "Event" | "Ticket" | ...
  entityId      Int?
  detail        String?
  responsibleId Int?
  responsible   User?       @relation("auditResponsible", fields: [responsibleId], references: [id])

  @@index([entity, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}
