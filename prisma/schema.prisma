// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — SocialClub
//
// Alcance de esta versión inicial (Sprint 1):
//   - Autenticación (login / logout)             → US-39, US-40
//   - Auditoría inalterable de operaciones        → US-32 / RF12 / RNF03
//   - Usuarios administrativos con roles           → US-01, US-02, US-03 / RF02
//   - Socios (Persona + CategoriaSocio)            → US-12 a US-15 / RF01
//   - Eventos y Entradas con código QR             → US-XX (entradas únicas)
//   - Eventos y Entradas con código QR             → US-XX (entradas únicas)
//
// El modelo está diseñado para crecer hacia el dominio completo del Diagrama de
// Clases (Disciplina, Inscripcion, CuotaSocio, Pago, Evento, Entrada,
// Documentacion, etc.). Esas entidades se incorporarán en sprints posteriores
// sobre esta misma base, sin rediseños mayores (RNF08 - Escalabilidad modular).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Acciones registradas en la auditoría. Tiparlas evita inconsistencias de
/// strings sueltos y facilita filtrar/reportar (RF12).
enum AccionAuditoria {
  CREAR
  EDITAR
  BAJA
  REACTIVAR
  LOGIN
  LOGOUT
  LOGIN_FALLIDO
}

/// Estados posibles de una entrada vendida. Una entrada nace VALIDA y cambia
/// de estado cuando se la usa (acceso al evento) o cuando expira.
enum EstadoEntrada {
  VALIDA
  USADA
  EXPIRADA
}

/// Catálogo de roles del sistema. Un Usuario puede tener uno o más roles
/// simultáneos (RF02), de ahí la tabla intermedia UsuarioRol.
model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique // ej: ADMIN, COLABORADOR
  descripcion String?
  creadoEn    DateTime     @default(now())
  usuarios    UsuarioRol[]

  @@map("roles")
}

/// Usuario del sistema (quien inicia sesión). Es distinto de "Persona", que
/// representa a alguien gestionado por el club (socio, alumno, participante).
model Usuario {
  id                 Int                 @id @default(autoincrement())
  dni                String?             @unique
  email              String              @unique
  passwordHash       String
  nombre             String
  apellido           String
  activo             Boolean             @default(true)
  ultimoLogin        DateTime?
  creadoEn           DateTime            @default(now())
  actualizadoEn      DateTime            @updatedAt
  roles              UsuarioRol[]
  registrosAuditoria RegistroAuditoria[] @relation("usuarioResponsable")

  @@map("usuarios")
}

/// Relación N a N entre Usuario y Rol (RF02: múltiples roles simultáneos).
model UsuarioRol {
  usuarioId   Int
  rolId       Int
  asignadoEn  DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol         Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

/// Categoría de socio (ej: Activo, Vitalicio, Cadete). En sprints posteriores
/// condiciona el cálculo de cuotas (RF04).
model CategoriaSocio {
  id                             Int                                @id @default(autoincrement())
  nombre                         String                             @unique
  descripcion                    String?
  personas                       Persona[]
  configuracionesCuotaDeportiva  ConfiguracionCuotaDeportiva[]

  @@map("categorias_socio")
}

/// Disciplina deportiva del club (ej: Fútbol, Vóley, Básquet). Cada una puede
/// tener un monto de cuota mensual distinto por categoría de socio.
model Disciplina {
  id                             Int                                @id @default(autoincrement())
  nombre                         String                             @unique
  descripcion                    String?
  activo                         Boolean                            @default(true)
  creadoEn                       DateTime                           @default(now())
  actualizadoEn                  DateTime                           @updatedAt
  configuracionesCuotaDeportiva  ConfiguracionCuotaDeportiva[]
  categorias    CategoriaDisciplina[]
  inscripciones Inscripcion[]

  @@map("disciplinas")
}

/// Configuración del monto mensual de la cuota deportiva por combinación
/// disciplina-categoría-período.
/// Los cambios de monto aplican a partir del período siguiente al configurado,
/// conservando el histórico de períodos anteriores.
model ConfiguracionCuotaDeportiva {
  id               Int             @id @default(autoincrement())
  disciplinaId     Int
  categoriaId      Int
  periodoAplicacion String         // "YYYY-MM" — período al que aplica el monto
  monto            Decimal         @db.Decimal(12, 2)
  activo           Boolean         @default(true)
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt
  disciplina       Disciplina      @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  categoria        CategoriaSocio  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([disciplinaId, categoriaId, periodoAplicacion])
  @@index([periodoAplicacion])
  @@map("configuraciones_cuota_deportiva")
}

/// Persona gestionada por la organización. En el Diagrama de Clases es la
/// entidad base; en esta versión se usa para representar socios (US-12 a US-15).
/// En sprints futuros se vincula con Documentacion, CuotaSocio e Inscripcion.
model Persona {
  id              Int             @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String          @unique
  fechaNacimiento DateTime?
  email           String?
  telefono        String?
  activo          Boolean         @default(true)
  categoriaId     Int?
  categoria       CategoriaSocio? @relation(fields: [categoriaId], references: [id])
  inscripciones   Inscripcion[]   
  creadoEn        DateTime        @default(now())
  actualizadoEn   DateTime        @updatedAt

  @@index([apellido, nombre])
  @@map("personas")
}

/// Evento del club. Cada Evento tiene un cupo de entradas disponibles; al
/// vender entradas se decrementa ese cupo de forma atómica.
model Evento {
  id                  Int       @id @default(autoincrement())
  nombre              String
  descripcion         String?
  entradasDisponibles Int       @default(0)
  entradas            Entrada[]
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  @@map("eventos")
}

/// Entrada única de un Evento. El `token` es un UUID v4 generado por el sistema
/// (único e irrepetible) que se codifica en el código QR de la entrada.
/// La constraint `@unique` en `token` garantiza que no existen dos entradas
/// con el mismo identificador (criterio de aceptación de la US).
model Entrada {
  id       Int           @id @default(autoincrement())
  token    String        @unique // UUID v4 seguro, único por entrada
  eventoId Int
  evento   Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  estado   EstadoEntrada @default(VALIDA)
  creadoEn DateTime      @default(now())

  @@index([eventoId])
  @@map("entradas")
}

/// Registro de auditoría inalterable (RF12 / RNF03 / RNF11).
/// IMPORTANTE: esta tabla SOLO admite INSERT desde la aplicación.
/// No debe ejecutarse UPDATE ni DELETE sobre ella (ver AuditoriaService).
model RegistroAuditoria {
  id            Int             @id @default(autoincrement())
  fechaHora     DateTime        @default(now())
  accion        AccionAuditoria
  entidad       String // "Usuario" | "Persona" | "Evento" | "Entrada" | ...
  idEntidad     Int?
  detalle       String?
  responsableId Int?
  responsable   Usuario?        @relation("usuarioResponsable", fields: [responsableId], references: [id])

  @@index([entidad, idEntidad])
  @@index([fechaHora])
  @@map("registros_auditoria")
}


/// Categoría dentro de una disciplina (ej: "Sub-15", "Primera", "Adultos").
model CategoriaDisciplina {
  id           Int      @id @default(autoincrement())
  nombre       String
  disciplinaId Int
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  inscripciones Inscripcion[]

  @@unique([disciplinaId, nombre])
  @@unique([id, disciplinaId])
  @@map("categorias_disciplina")
}

/// Una persona puede inscribirse en varias disciplinas a la vez, 
/// y cada inscripción se asocia como máximo
/// a una única CategoriaDisciplina.
model Inscripcion {
  id                    Int                  @id @default(autoincrement())
  personaId             Int
  persona               Persona              @relation(fields: [personaId], references: [id])
  disciplinaId          Int
  disciplina            Disciplina           @relation(fields: [disciplinaId], references: [id])
  categoriaDisciplinaId Int?
  categoriaDisciplina   CategoriaDisciplina? @relation(fields: [categoriaDisciplinaId], references: [id])

  fechaInscripcion DateTime @default(now())
  activo           Boolean  @default(true)
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt


  @@unique([personaId, disciplinaId])
  @@index([disciplinaId])
  @@map("inscripciones")
}
