// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — SocialClub
//
// Alcance de esta versión inicial (Sprint 1):
//   - Autenticación (login / logout)             → US-39, US-40
//   - Auditoría inalterable de operaciones        → US-32 / RF12 / RNF03
//   - Usuarios administrativos con roles           → US-01, US-02, US-03 / RF02
//   - Socios (Persona + CategoriaSocio)            → US-12 a US-15 / RF01
//   - Eventos y Entradas con código QR             → US-XX (entradas únicas)
//   - Eventos y Entradas con código QR             → US-XX (entradas únicas)
//
// El modelo está diseñado para crecer hacia el dominio completo del Diagrama de
// Clases (Disciplina, Inscripcion, CuotaSocio, Pago, Evento, Entrada,
// Documentacion, etc.). Esas entidades se incorporarán en sprints posteriores
// sobre esta misma base, sin rediseños mayores (RNF08 - Escalabilidad modular).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Género al que aplica una disciplina o categoría (restricción de inscripción).
/// También es el género registrado del participante (`Persona.genero`).
enum GeneroDisciplina {
  FEMENINO
  MASCULINO
  NO_BINARIO_NO_ESPECIFICADO
}

/// Catálogo cerrado de documentación que puede exigirse por disciplina.
enum TipoDocumentacionDisciplina {
  DNI
  FICHA_INSCRIPCION
  CERTIFICADO_MEDICO_APTITUD_FISICA
  SEGURO_COBERTURA_MEDICA
  AUTORIZACION_PADRES_TUTORES
  CARNET_FEDERATIVO_LICENCIA_DEPORTIVA
  REGLAMENTO_INTERNO_FIRMADO
  FICHA_TECNICA_NATACION
  FICHA_TECNICA_GIMNASIO_FITNESS
  FICHA_TECNICA_ARTES_MARCIALES
  FICHA_TECNICA_DEPORTES_CONTACTO
  COMPROBANTE_PAGO_CUOTA_SOCIAL_DEPORTIVA
}

/// Acciones registradas en la auditoría. Tiparlas evita inconsistencias de
/// strings sueltos y facilita filtrar/reportar (RF12).
enum AccionAuditoria {
  CREAR
  EDITAR
  BAJA
  REACTIVAR
  LOGIN
  LOGOUT
  LOGIN_FALLIDO
}

/// Estados posibles de una entrada vendida. Una entrada nace VALIDA y cambia
/// de estado cuando se la usa (acceso al evento) o cuando expira.
enum EstadoEvento {
  BORRADOR
  PUBLICADO
  CANCELADO
  FINALIZADO
}

enum EstadoEntrada {
  VALIDA
  USADA
  EXPIRADA
}

/// Canales por los que sale una notificación (DT-36). Hoy solo email; push y
/// bandeja interna se suman como valores nuevos sin tocar a quien notifica.
enum CanalNotificacion {
  EMAIL
}

/// Ciclo de vida de una notificación en el outbox (DT-36).
enum EstadoNotificacion {
  PENDIENTE
  ENVIADA
  FALLIDA
}

/// Quién disparó una tarea automática (DT-22).
enum OrigenEjecucion {
  PROGRAMADA
  MANUAL
}

/// Resultado de una ejecución de tarea automática (DT-22).
enum EstadoEjecucion {
  EN_CURSO
  EXITOSA
  FALLIDA
  /// No se ejecutó porque la misma tarea ya estaba corriendo.
  OMITIDA
}

enum EstadoCompraEntrada {
  APROBADA
}

/// Catálogo de roles del sistema. Un Usuario puede tener uno o más roles
/// simultáneos (RF02), de ahí la tabla intermedia UsuarioRol.
model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique // ej: ADMIN, COLABORADOR
  descripcion String?
  creadoEn    DateTime     @default(now())
  usuarios    UsuarioRol[]

  @@map("roles")
}

/// Usuario del sistema (quien inicia sesión). Es distinto de "Persona", que
/// representa a alguien gestionado por el club (socio, alumno, participante).
/// Un Usuario puede tener como máximo una Persona asociada (relación 1:1,
/// garantizada por `Persona.usuarioId` @unique). Así, el mismo Usuario que se
/// autogestiona como socio (US-09) queda vinculado a su ficha de Persona.
model Usuario {
  id                          Int                       @id @default(autoincrement())
  email                       String                    @unique
  passwordHash                String
  nombre                      String
  apellido                    String
  activo                      Boolean                   @default(true)
  ultimoLogin                 DateTime?
  creadoEn                    DateTime                  @default(now())
  actualizadoEn               DateTime                  @updatedAt
  personaId                   Int                       @unique
  persona                     Persona                   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  roles                       UsuarioRol[]
  registrosAuditoria          RegistroAuditoria[]       @relation("usuarioResponsable")
  pagosDeportivos             PagoCuotaDeportiva[]      @relation("responsablePagoDeportivo")
  comprasEntradas             CompraEntrada[]
  habilitacionesExcepcionales HabilitacionExcepcional[] @relation("responsableHabilitacionExcepcional")
  notificaciones              Notificacion[]
  ejecucionesTareas           EjecucionTarea[]

  @@map("usuarios")
}

/// Relación N a N entre Usuario y Rol (RF02: múltiples roles simultáneos).
model UsuarioRol {
  usuarioId  Int
  rolId      Int
  asignadoEn DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol        Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

/// Categoría de socio. Condiciona el cálculo de cuotas (RF04).
/// US16: determina las 3 cuotas sociales (Cuota Juvenil / General / Senior).
model CategoriaSocio {
  id                         Int                        @id @default(autoincrement())
  nombre                     String                     @unique
  descripcion                String?
  membresias                 Membresia[]
  configuracionesCuotaSocial ConfiguracionCuotaSocial[]

  @@map("categorias_socio")
}

/// Disciplina deportiva del club (ej: Fútbol, Vóley, Básquet). Cada una puede
/// tener un monto de cuota mensual distinto por categoría de socio.
model Disciplina {
  id                            Int                           @id @default(autoincrement())
  nombre                        String                        @unique
  descripcion                   String?
  /// Restricción de género para la inscripción. Null = sin restricción.
  genero                        GeneroDisciplina?
  /// Edad mínima para inscribirse, medida como la edad que se cumple en el año
  /// calendario (año actual - año de nacimiento). Null = sin mínimo.
  edadMinima                    Int?
  /// Edad máxima para inscribirse (edad que se cumple en el año calendario).
  /// Null = sin máximo.
  edadMaxima                    Int?
  /// Indica si la disciplina exige documentación para la inscripción/permanencia.
  solicitaDocumentacion         Boolean                       @default(false)
  activo                        Boolean                       @default(true)
  creadoEn                      DateTime                      @default(now())
  actualizadoEn                 DateTime                      @updatedAt
  configuracionesCuotaDeportiva ConfiguracionCuotaDeportiva[]
  categorias                    CategoriaDisciplina[]
  inscripciones                 Inscripcion[]
  requerimientosDoc             DisciplinaRequerimientoDoc[]
  pagosDeportivos               PagoCuotaDeportiva[]

  @@map("disciplinas")
}

/// Tipos de documentación obligatoria requeridos para la inscripción o
/// permanencia de un participante (ej: "Apto Médico", "DNI").
/// - `categoriaDisciplinaId` null → requisito de toda la disciplina (US-44/45).
/// - `categoriaDisciplinaId` con valor → requisito ADICIONAL de esa categoría
///   (US-48/49). Lo exigido a un participante es la suma de ambos.
/// Al editar se sincroniza por tipo (no delete-all): `creadoEn` indica desde
/// cuándo rige el requisito y es la base del plazo para los ya inscriptos.
/// La unicidad con categoría null (Postgres trata NULL como distinto) se
/// garantiza en el service.
model DisciplinaRequerimientoDoc {
  id                    Int                         @id @default(autoincrement())
  disciplinaId          Int
  disciplina            Disciplina                  @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  categoriaDisciplinaId Int?
  categoriaDisciplina   CategoriaDisciplina?        @relation(fields: [categoriaDisciplinaId], references: [id], onDelete: Cascade)
  tipoDocumento         TipoDocumentacionDisciplina
  /// 0 = debe estar presentada al inscribirse; mayor a 0 = días corridos de tolerancia.
  plazoDiasTolerancia   Int                         @default(0)
  creadoEn              DateTime                    @default(now())

  @@unique([disciplinaId, categoriaDisciplinaId, tipoDocumento])
  @@index([disciplinaId])
  @@index([categoriaDisciplinaId])
  @@map("disciplina_requerimientos_doc")
}

/// Tarifa mensual de la cuota deportiva (US-20 · TASK-33). Rige desde
/// `periodoAplicacion` hasta que otra la reemplace.
/// - `categoriaDisciplinaId` null → tarifa base de la disciplina.
/// - con valor → tarifa propia de esa categoría (reemplaza a la base).
/// - `descuentoSocioPorcentaje`: descuento para quien es socio en ese mes.
/// La unicidad con categoría null (Postgres trata NULL como distinto) se
/// garantiza en el service.
model ConfiguracionCuotaDeportiva {
  id                       Int                  @id @default(autoincrement())
  disciplinaId             Int
  categoriaDisciplinaId    Int?
  periodoAplicacion        String // "YYYY-MM" — período desde el que rige el monto
  monto                    Decimal              @db.Decimal(12, 2)
  descuentoSocioPorcentaje Int                  @default(0)
  activo                   Boolean              @default(true)
  creadoEn                 DateTime             @default(now())
  actualizadoEn            DateTime             @updatedAt
  disciplina               Disciplina           @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  categoriaDisciplina      CategoriaDisciplina? @relation(fields: [categoriaDisciplinaId], references: [id], onDelete: Cascade)

  @@unique([disciplinaId, categoriaDisciplinaId, periodoAplicacion])
  @@index([periodoAplicacion])
  @@index([categoriaDisciplinaId])
  @@map("configuraciones_cuota_deportiva")
}

/// Configuración del monto mensual de la cuota social por categoría de socio.
/// US16: el administrador configura el monto mensual que deben abonar los socios.
/// Tres cuotas canónicas: Cuota Juvenil / General / Senior.
/// Los cambios aplican a partir del período siguiente (YYYY-MM), no se permite
/// guardar montos <= 0. Histórico por período.
model ConfiguracionCuotaSocial {
  id                Int            @id @default(autoincrement())
  categoriaId       Int
  periodoAplicacion String // "YYYY-MM"
  monto             Decimal        @db.Decimal(12, 2)
  activo            Boolean        @default(true)
  creadoEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt
  categoria         CategoriaSocio @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, periodoAplicacion])
  @@index([periodoAplicacion])
  @@map("configuraciones_cuota_social")
}

/// Membresía: un período como socio. Una persona puede tener varias
/// membresías históricas (personaId sin @unique). Como regla de negocio se
/// valida en el backend un máximo de una membresía activa por Persona.
model Membresia {
  id            Int            @id @default(autoincrement())
  personaId     Int
  persona       Persona        @relation(fields: [personaId], references: [id], onDelete: Cascade)
  categoriaId   Int
  categoria     CategoriaSocio @relation(fields: [categoriaId], references: [id])
  fechaAlta     DateTime       @default(now())
  fechaBaja     DateTime?
  activo        Boolean        @default(true)
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt

  @@index([personaId])
  @@index([categoriaId])
  @@map("membresias")
}

/// Persona gestionada por la organización. Identidad física: raíz del dominio.
/// Existe con o sin Usuario, con o sin Membresia, con o sin Inscripcion.
/// Persona gestionada por la organización. Identidad física: raíz del dominio.
/// Existe con o sin Usuario, con o sin Membresia, con o sin Inscripcion.
/// US-07: `activo` es el estado propio del participante (Inactivo = dado de baja
/// por el delegado). No se confunde con la vigencia de cada inscripción
/// (`Inscripcion.activo`, que expone US-08 como INSCRIPTO/BAJA): un participante
/// inactivo está bloqueado y no puede ser inscripto en ninguna disciplina.
model Persona {
  id              Int               @id @default(autoincrement())
  nombre          String
  apellido        String
  dni             String?           @unique
  fechaNacimiento DateTime?
  /// Género registrado, para validar restricciones de disciplina/categoría (US-5).
  genero          GeneroDisciplina?
  email           String?           @unique
  telefono        String?
  activo          Boolean           @default(true)
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt

  usuario         Usuario?
  membresias      Membresia[]
  inscripciones   Inscripcion[]
  documentaciones Documentacion[]
  pagos           Pago[]
  pagosDeportivos PagoCuotaDeportiva[]

  @@index([apellido, nombre])
  @@index([activo])
  @@map("personas")
}

/// Evento del club. Cada Evento tiene un cupo de entradas disponibles; al
/// vender entradas se decrementa ese cupo de forma atómica.
model Evento {
  id                  Int             @id @default(autoincrement())
  nombre              String
  descripcion         String?
  requiereEntrada     Boolean         @default(true)
  capacidadMaxima     Int?
  entradasDisponibles Int?
  precio              Decimal         @default(0) @db.Decimal(12, 2)
  descuentoSocio      Int             @default(0)
  estado              EstadoEvento    @default(BORRADOR)
  fechaEvento         DateTime
  fechaFin            DateTime?
  imagen              String?
  lugarAcreditacion   String
  inicioVenta         DateTime?
  finVenta            DateTime?
  entradas            Entrada[]
  compras             CompraEntrada[]
  creadoEn            DateTime        @default(now())
  actualizadoEn       DateTime        @updatedAt

  @@map("eventos")
}

/// Entrada única de un Evento. El `token` es un UUID v4 generado por el sistema
/// (único e irrepetible) que se codifica en el código QR de la entrada.
/// La constraint `@unique` en `token` garantiza que no existen dos entradas
/// con el mismo identificador (criterio de aceptación de la US).
model Entrada {
  id       Int            @id @default(autoincrement())
  token    String         @unique // UUID v4 seguro, único por entrada
  eventoId Int
  evento   Evento         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  compraId Int?
  compra   CompraEntrada? @relation(fields: [compraId], references: [id], onDelete: SetNull)
  estado   EstadoEntrada  @default(VALIDA)
  creadoEn DateTime       @default(now())

  @@index([eventoId])
  @@index([compraId])
  @@map("entradas")
}

/// Compra aprobada de una o más entradas. Los datos sensibles de la tarjeta
/// nunca se almacenan; solo se conserva el método mock y los importes.
model CompraEntrada {
  id             Int                 @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  eventoId       Int
  evento         Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  cantidad       Int
  precioUnitario Decimal             @db.Decimal(12, 2)
  montoTotal     Decimal             @db.Decimal(12, 2)
  estado         EstadoCompraEntrada @default(APROBADA)
  metodoPago     String              @default("MOCK_TARJETA")
  creadoEn       DateTime            @default(now())
  entradas       Entrada[]

  @@index([usuarioId, creadoEn])
  @@index([eventoId])
  @@map("compras_entradas")
}

/// Registro de auditoría inalterable (RF12 / RNF03 / RNF11).
/// IMPORTANTE: esta tabla SOLO admite INSERT desde la aplicación.
/// No debe ejecutarse UPDATE ni DELETE sobre ella (ver AuditoriaService).
model RegistroAuditoria {
  id            Int             @id @default(autoincrement())
  fechaHora     DateTime        @default(now())
  accion        AccionAuditoria
  entidad       String // "Usuario" | "Persona" | "Evento" | "Entrada" | ...
  idEntidad     Int?
  detalle       String?
  responsableId Int?
  responsable   Usuario?        @relation("usuarioResponsable", fields: [responsableId], references: [id])

  @@index([entidad, idEntidad])
  @@index([fechaHora])
  @@map("registros_auditoria")
}

/// Categoría dentro de una disciplina (ej: "Sub-15", "Primera", "Adultos").
/// Sus restricciones de género y edad afinan las de la disciplina y deben
/// quedar dentro de ellas (US-48/49). La edad se mide por año de nacimiento:
/// edad que se cumple en el año calendario. Null = hereda de la disciplina.
model CategoriaDisciplina {
  id           Int               @id @default(autoincrement())
  nombre       String
  disciplinaId Int
  disciplina   Disciplina        @relation(fields: [disciplinaId], references: [id])
  genero       GeneroDisciplina?
  edadMinima   Int?
  edadMaxima   Int?
  activo       Boolean           @default(true)
  creadoEn     DateTime          @default(now())

  inscripciones     Inscripcion[]
  requerimientosDoc DisciplinaRequerimientoDoc[]
  tarifas           ConfiguracionCuotaDeportiva[]

  @@unique([disciplinaId, nombre])
  @@unique([id, disciplinaId])
  @@map("categorias_disciplina")
}

/// Una persona puede inscribirse en varias disciplinas a la vez, 
/// y cada inscripción se asocia como máximo
/// a una única CategoriaDisciplina.
model Inscripcion {
  id                    Int                  @id @default(autoincrement())
  personaId             Int
  persona               Persona              @relation(fields: [personaId], references: [id])
  disciplinaId          Int
  disciplina            Disciplina           @relation(fields: [disciplinaId], references: [id])
  categoriaDisciplinaId Int?
  categoriaDisciplina   CategoriaDisciplina? @relation(fields: [categoriaDisciplinaId], references: [id])

  fechaInscripcion DateTime  @default(now())
  /// Desde cuándo corre el plazo de presentación de la documentación exigida
  /// (ej. al cambiar de categoría, US-6). Null = desde `fechaInscripcion`.
  requisitosDesde  DateTime?
  activo           Boolean   @default(true)
  /// Fecha en que se dio de baja la inscripción (null mientras está activa).
  fechaBaja        DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  habilitacionesExcepcionales HabilitacionExcepcional[]
  /// DT-41: cada alta y baja de la inscripción. La deuda de cuota deportiva se
  /// calcula sobre todos los períodos, no solo sobre el último.
  periodos                    PeriodoInscripcion[]

  @@unique([personaId, disciplinaId])
  @@index([disciplinaId])
  @@map("inscripciones")
}

/// DT-41: un tramo en que la persona estuvo inscripta en la disciplina. Al
/// reinscribirse se abre uno nuevo y los anteriores conservan su deuda.
model PeriodoInscripcion {
  id            Int         @id @default(autoincrement())
  inscripcionId Int
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  desde         DateTime
  /// Fecha de baja; null mientras el período está vigente.
  hasta         DateTime?
  creadoEn      DateTime    @default(now())

  @@index([inscripcionId])
  @@map("periodos_inscripcion")
}

/// Documentación obligatoria de un participante (US-24). Habilita la
/// participación en la actividad correspondiente. Cada documento requiere tipo,
/// fecha de vencimiento e integrante (Persona) asociado. La regla "la fecha de
/// vencimiento no puede ser anterior a hoy" se valida en el backend al cargar.
model Documentacion {
  id               Int                          @id @default(autoincrement())
  /// Descripción libre heredada (antes era el único dato del tipo).
  tipo             String
  /// Tipo del catálogo que cubre un requisito de disciplina/categoría.
  /// Null en documentos cargados antes del catálogo que no pudieron mapearse.
  tipoDocumento    TipoDocumentacionDisciplina?
  fechaVencimiento DateTime
  personaId        Int
  persona          Persona                      @relation(fields: [personaId], references: [id], onDelete: Cascade)
  // Archivo adjunto opcional (PDF/imagen). El binario se guarda en el filesystem
  // del servidor (ruta configurable); en la BD solo la referencia.
  archivoNombre    String? // nombre original subido por el usuario
  archivoRuta      String? // nombre del archivo almacenado (relativo al dir de storage)
  mimeType         String?
  tamano           Int? // en bytes
  creadoEn         DateTime                     @default(now())
  actualizadoEn    DateTime                     @updatedAt

  @@index([personaId])
  @@index([personaId, tipoDocumento])
  @@map("documentaciones")
}

/// Habilitación excepcional de una inscripción bloqueada por documentación
/// (US-28): el administrador registra el motivo y hasta cuándo rige.
/// Solo INSERT: el historial de excepciones no se edita.
model HabilitacionExcepcional {
  id            Int         @id @default(autoincrement())
  inscripcionId Int
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  motivo        String
  hasta         DateTime
  responsableId Int
  responsable   Usuario     @relation("responsableHabilitacionExcepcional", fields: [responsableId], references: [id])
  creadoEn      DateTime    @default(now())

  @@index([inscripcionId])
  @@map("habilitaciones_excepcionales")
}

/// Pago de cuota realizado por un socio (US-10).
/// Registra monto, fecha/hora, período cubierto ("YYYY-MM") y método de pago.
/// La restricción @@unique([personaId, periodo]) garantiza que no sea posible
/// registrar un pago por un período que ya figura como pagado.
model Pago {
  id         Int      @id @default(autoincrement())
  personaId  Int
  persona    Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  periodo    String // "YYYY-MM"
  monto      Decimal  @db.Decimal(12, 2)
  metodoPago String   @default("MOCK_TARJETA")
  fechaPago  DateTime @default(now())
  creadoEn   DateTime @default(now())

  @@unique([personaId, periodo])
  @@index([personaId])
  @@index([periodo])
  @@map("pagos")
}

/// Pago de cuota DEPORTIVA registrado por secretaría (US-21).
/// A diferencia de `Pago` (cuota social), la deuda deportiva es por disciplina:
/// un jugador puede adeudar la cuota de cada disciplina en la que está inscripto.
/// Registra monto, fecha/hora, período cubierto ("YYYY-MM"), disciplina y el
/// usuario responsable del cobro. La restricción @@unique([personaId, disciplinaId,
/// periodo]) garantiza que no sea posible registrar un pago por un período que ya
/// figura como pagado para esa disciplina.
model PagoCuotaDeportiva {
  id            Int        @id @default(autoincrement())
  personaId     Int
  persona       Persona    @relation(fields: [personaId], references: [id], onDelete: Cascade)
  disciplinaId  Int
  disciplina    Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  periodo       String // "YYYY-MM"
  monto         Decimal    @db.Decimal(12, 2)
  metodoPago    String     @default("EFECTIVO")
  fechaPago     DateTime   @default(now())
  // Usuario responsable del cobro (secretaría). Nullable para no romper si se
  // borra el usuario; la auditoría conserva el registro inalterable.
  responsableId Int?
  responsable   Usuario?   @relation("responsablePagoDeportivo", fields: [responsableId], references: [id])
  creadoEn      DateTime   @default(now())

  @@unique([personaId, disciplinaId, periodo])
  @@index([personaId])
  @@index([disciplinaId])
  @@index([periodo])
  @@map("pagos_cuota_deportiva")
}

/// Notificación saliente (DT-36): outbox de todos los avisos del sistema.
/// Se guarda ANTES de enviarse, con el contenido ya armado, así un envío
/// fallido o un canal sin configurar se reintenta igual. `referencias` son las
/// claves de los ítems avisados (p. ej. cada alerta de documentación): un ítem
/// ya referenciado no se vuelve a avisar.
model Notificacion {
  id          Int                @id @default(autoincrement())
  /// Tipo de aviso, p. ej. ALERTAS_DOCUMENTACION.
  tipo        String
  canal       CanalNotificacion
  usuarioId   Int?
  usuario     Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  /// Dirección en el canal (el email al momento de crearla).
  destino     String
  /// Contenido ya armado por la plantilla (en email: asunto, html y texto).
  contenido   Json
  referencias String[]
  estado      EstadoNotificacion @default(PENDIENTE)
  intentos    Int                @default(0)
  ultimoError String?
  creadaEn    DateTime           @default(now())
  enviadaEn   DateTime?

  @@index([tipo])
  @@index([estado])
  @@index([referencias], type: Gin)
  @@map("notificaciones")
}

/// Registro de cada ejecución de una tarea automática (DT-22): cuándo corrió,
/// quién la disparó y qué hizo. Una ejecución que quedó EN_CURSO porque el
/// proceso se cortó se marca FALLIDA en la siguiente.
model EjecucionTarea {
  id        Int             @id @default(autoincrement())
  /// Nombre de la tarea, p. ej. vencimientos-documentacion.
  tarea     String
  origen    OrigenEjecucion
  /// Usuario que la ejecutó a mano (null si fue programada).
  usuarioId Int?
  usuario   Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  estado    EstadoEjecucion @default(EN_CURSO)
  inicio    DateTime        @default(now())
  fin       DateTime?
  /// Resumen que devuelve la tarea (contadores).
  resultado Json?
  error     String?

  @@index([tarea, inicio])
  @@map("ejecuciones_tareas")
}
