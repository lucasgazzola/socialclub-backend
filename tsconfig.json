{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // TS 6 marca como error algunas opciones que se removerán en TS 7
    // (baseUrl, moduleResolution=node). Las seguimos usando intencionalmente
    // por compatibilidad con NestJS; esta opción silencia el aviso.
    "ignoreDeprecations": "6.0",
    "incremental": false,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    // Los DTOs/entidades de Nest se inicializan vía decoradores (class-validator,
    // Prisma), no en el constructor. Desactivamos solo esta comprobación.
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma", "**/*spec.ts"]
}
