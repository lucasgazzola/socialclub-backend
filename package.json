{
  "name": "socialclub-backend",
  "version": "0.1.0",
  "description": "SocialClub - API REST (NestJS + Prisma + PostgreSQL) - Equipo Nullpointer",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:check-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url postgresql://socialclub:socialclub@localhost:5432/socialclub_shadow?schema=public --exit-code",
    "docs:para-pegar": "node scripts/para-pegar.mjs",
    "docs:comparar-planilla": "python3 scripts/comparar-planilla.py",
    "docs:backlog": "python3 scripts/leer-backlog.py",
    "db:shadow": "docker compose exec -T db psql -U socialclub -d postgres -c \"CREATE DATABASE socialclub_shadow;\"",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "build:seed": "tsc prisma/seed.ts --ignoreConfig --outDir prisma --module nodenext --moduleResolution nodenext --target ES2023 --skipLibCheck --esModuleInterop",
    "db:setup": "prisma migrate dev && npm run prisma:seed",
    "db:reset": "prisma db push --force-reset --accept-data-loss --skip-generate && npm run prisma:seed",
    "up": "docker compose up --build -d",
    "down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.27",
    "@nestjs/swagger": "11.4.4",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.2.0",
    "nodemailer": "10.0.14",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.27",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "maxWorkers": "25%",
    "workerIdleMemoryLimit": "512MB",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "**/*.controller.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 70,
        "branches": 70,
        "functions": 61,
        "lines": 69
      }
    },
    "testEnvironment": "node"
  }
}
